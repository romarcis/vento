{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vento",
  "version": "0.1.0",
  "identifier": "it.romarcis.vento",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Vento", "width": 1180, "height": 760, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
